// This file contains the Prisma schema for the database models used in the application.

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  password      String
  name          String?
  avatarUrl     String?
  email         String?   @unique
  venmoUsername String?
  isAdmin       Boolean   @default(false)
  isActive      Boolean   @default(true)
  nutritionOnly Boolean   @default(false)  // restricted to the nutrition calculator only
}

model List {
  id         String   @id @default(cuid())
  label      String
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ExpenseTemplate {
  id           Int       @id @default(autoincrement())
  description  String
  amount       Float
  category     String
  assignees    String    // JSON array of usernames
  recurring    Boolean   @default(false)
  frequency    String?   // "weekly" | "monthly"
  dayOfMonth   Int?      // for monthly
  dayOfWeek    String?   // for weekly ("monday", etc.)
  createdBy    String
  createdAt    DateTime  @default(now())

  occurrences  Expense[] // Relation field
}

model Expense {
  id             Int       @id @default(autoincrement())
  description    String
  amount         Float
  category       String
  assignees      String    // JSON array
  paid           Boolean   @default(false)
  createdBy      String
  createdAt      DateTime  @default(now())  
  templateId     Int?      
  template       ExpenseTemplate? @relation(fields: [templateId], references: [id])
}

// ── Health & Nutrition ────────────────────────────────────────────────────────

model UserHealthProfile {
  id               String  @id @default(cuid())
  userId           String  @unique
  dailyCalorieGoal Int     @default(2000)
  proteinGoal      Int     @default(150)
  carbGoal         Int     @default(200)
  fatGoal          Int     @default(65)
  fiberGoal        Int     @default(28)   // g
  waterGoal        Int     @default(64)   // oz
}

model FoodItem {
  id          Int       @id @default(autoincrement())
  name        String
  brand       String?
  calories    Int
  protein     Float
  carbs       Float
  fat         Float
  fiber       Float     @default(0)
  sugar       Float     @default(0)
  servingSize Float     @default(1)
  servingUnit String    @default("serving")
  createdBy   String
  logs        FoodLog[]
}

model PresetMeal {
  id        Int      @id @default(autoincrement())
  name      String
  items     String   // JSON: [{ foodItemId, servings }]
  createdBy String
  createdAt DateTime @default(now())
}

model FoodLog {
  id          Int      @id @default(autoincrement())
  userId      String
  foodItemId  Int
  foodItem    FoodItem @relation(fields: [foodItemId], references: [id])
  mealType    String   // breakfast | lunch | dinner | snack
  servings    Float    @default(1)
  logDate     String   // YYYY-MM-DD  (local date, for easy day queries)
  loggedAt    DateTime @default(now())
  aiGenerated Boolean  @default(false)
  photoUrl    String?
  note        String?
}

model WeightLog {
  id       Int      @id @default(autoincrement())
  userId   String
  weight   Float
  loggedAt DateTime @default(now())
}

model WaterLog {
  id       Int      @id @default(autoincrement())
  userId   String
  amount   Int      @default(0)   // total oz for the day
  logDate  String                 // YYYY-MM-DD
  loggedAt DateTime @default(now())

  @@unique([userId, logDate])
}

